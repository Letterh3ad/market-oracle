# Copy to oracle.toml. Every key is optional; these are the defaults.
# Relative paths resolve against this file's folder.

db_path = "oracle.db"   # the database file
research_db_path = "research.db"   # the signal testbed's own database; the testbed never writes the one above

# ISO 4217 code. Every price, position and P&L is converted to this.
base_currency = "GBP"   # every price, position and P&L is shown in this currency

# Per-source request pacing, shared by every oracle process on this database.
# Override any field of a built-in source, or add a new one (rate_per_second required).
# Built-ins: yahoo 0.5, eodhd 2.0, ecb 0.5, frankfurter 0.5, open_er_api 0.05, gdelt 0.1, google_news 0.5, ddgs 0.2, sec_edgar 5.0, web 1.0 (pages research reads),
# financedatabase 0.5 (GitHub, used by `oracle universe refresh`), wikipedia 0.2, github 0.5 (the S&P 500 history)
[sources.gdelt]
rate_per_second = 0.1   # requests a second (GDELT asks for one per 5 seconds and locks out quicker ones)
cooldown_s = 900        # how long a tripped breaker stays open
max_retries = 1         # retries on 429/5xx before giving up

# Where daily prices come from, tried in order per listing until one has data.
# Keyed sources are skipped until their key is set below.
[prices]
sources = ["yahoo", "eodhd"]   # price sources, tried in this order

# Where exchange rates into base_currency come from, tried in order per currency.
# yahoo, ecb and frankfurter have history; open_er_api has today's rate only.
[fx]
sources = ["yahoo", "ecb", "frankfurter", "eodhd", "open_er_api"]   # FX sources, tried in this order

# Deterministic analysts.
[analysts]
peers = 20   # companies a factor score is compared against (5 to 100)

# How the universe groups listings into companies.
[universe]
suffix_blind_grouping = false   # true: names equal but for legal forms (plc, Inc., AG) are one company from the next refresh (see Proposed merges first)

# Paper-account sizing, in base_currency. A position at target_volatility (yearly swing)
# gets the full max_position; twice as volatile, half. Shares are 0 to 1.
[risk]
account = 10000           # paper account size
max_position = 0.10       # largest share of the account one position may take
cash_floor = 0.20         # share of the account always kept in cash
target_volatility = 0.20  # yearly swing at which a position gets the full max_position

# The strategy paper account's rules (sizing comes from [risk]).
[strategy]
min_probability = 0.6   # buy only on a buy/strong buy lean at least this likely
max_positions = 10      # most positions held at once (1 to 50)
stop_loss = 0.08        # sell a position 8% below its average cost

# Market index lines shown beside the accounts in the Ledgers comparison. Priced
# alongside watched listings but never traded, researched, analysed or watchlisted.
[compare]
benchmarks = ["VWRL.L", "VUSA.L"]   # symbols to hold from the AI account's start day, no costs

# `oracle gui`. Localhost only by default: nothing else on the network can reach it.
[gui]
host = "127.0.0.1"   # the address the GUI listens on
port = 8740          # 1024 to 65535

# Automatic ticks (prices, FX, fills, analysis, strategy step) while `oracle gui` runs.
# Weekdays only, at this local time. A run missed while the app was closed runs once
# on the next start. The GUI's Ticks panel changes these too.
[schedule]
enabled = false   # true: ticks run by themselves on weekdays
time = "22:30"   # 24-hour, local time
warn_minutes = 10            # the GUI warns this long before, with Postpone and Skip (0 off, up to 120)
research_when_idle = false   # true: a tick researches only once the PC has sat idle idle_minutes
idle_minutes = 15            # 1 to 240; otherwise research waits for the next tick
midday_time = "12:30"        # a midday pass (discovery, then stale research; no prices, no trades); "" off
midday_budget_min = 60       # minutes the midday pass may start work in, discovery included (1 to 480)
fill_times = ["09:30", "15:15"]  # fill passes (prices, FX, fills only) so orders fill at the open; [] off

# The master switch for everything that starts by itself (scheduled ticks now, later AI
# research refreshes and discovery). Off: nothing starts on its own; buttons still work.
# The GUI header's Automation switch changes it too.
[automation]
enabled = true   # false: nothing starts by itself

# The AI paper account: trades each watched listing's latest research verdict under the
# strategy's rules, limits and starting cash. Unvalidated; off until you turn it on (the
# Ledgers tab's switch and fields change these too). While it is on, each tick first
# researches watched listings whose report is missing, too old, or behind a price move,
# most stale first, then runs the AI step.
[ai_account]
enabled = false            # true: the AI account trades research verdicts
max_verdict_age_days = 7   # an older verdict is never traded, and is researched again (1 to 90)
move_threshold = 0.05      # research again after the price moved this share since the report
research_budget_min = 120   # minutes a tick may spend starting research; the rest waits (1 to 480)

# The regime account: trades a blend of well-studied methods (trend, momentum, mean reversion,
# low volatility, value and quality, post-earnings drift, buy-and-hold, the research verdict)
# weighted by the market's mood, under the strategy's rules. Rules only, no model.
[regime_account]
enabled = true             # false: the regime account decides nothing each tick

# The regime-ai paper account: the same blend, with the weights tilted once a day by a local
# model (within [regime] tilt_cap). No answer, bad JSON or the model down: the rules weights.
[regime_ai_account]
enabled = true             # false: the regime-ai account decides nothing each tick
model = ""                 # model profile that tilts the weights; "" uses the research slot's

# Regime lines: a blend of known trading methods weighted by the market's mood. Weights
# are the literature's priors per mood (<mood>_<method>, each mood renormalised, 0 to 1).
[regime]
calm_up_trend = 0.15   # weight of trend (close vs 200-day average) in a calm rising market
calm_up_momentum = 0.25   # weight of 12-1 momentum in a calm rising market
calm_up_reversion = 0.05   # weight of RSI-2 mean reversion in a calm rising market
calm_up_low_vol = 0.05   # weight of low volatility in a calm rising market
calm_up_quality_value = 0.10   # weight of value and quality factors in a calm rising market
calm_up_earnings_drift = 0.10   # weight of post-earnings drift in a calm rising market
calm_up_hold = 0.15   # weight of buy-and-hold's constant lean in a calm rising market
calm_up_ai_verdict = 0.15   # weight of the research verdict in a calm rising market
volatile_up_trend = 0.10   # weight of trend (close vs 200-day average) in a volatile rising market
volatile_up_momentum = 0.10   # weight of 12-1 momentum in a volatile rising market
volatile_up_reversion = 0.15   # weight of RSI-2 mean reversion in a volatile rising market
volatile_up_low_vol = 0.20   # weight of low volatility in a volatile rising market
volatile_up_quality_value = 0.10   # weight of value and quality factors in a volatile rising market
volatile_up_earnings_drift = 0.10   # weight of post-earnings drift in a volatile rising market
volatile_up_hold = 0.10   # weight of buy-and-hold's constant lean in a volatile rising market
volatile_up_ai_verdict = 0.15   # weight of the research verdict in a volatile rising market
calm_down_trend = 0.25   # weight of trend (close vs 200-day average) in a calm falling market
calm_down_momentum = 0.10   # weight of 12-1 momentum in a calm falling market
calm_down_reversion = 0.10   # weight of RSI-2 mean reversion in a calm falling market
calm_down_low_vol = 0.20   # weight of low volatility in a calm falling market
calm_down_quality_value = 0.15   # weight of value and quality factors in a calm falling market
calm_down_earnings_drift = 0.05   # weight of post-earnings drift in a calm falling market
calm_down_hold = 0.00   # weight of buy-and-hold's constant lean in a calm falling market
calm_down_ai_verdict = 0.15   # weight of the research verdict in a calm falling market
volatile_down_trend = 0.20   # weight of trend (close vs 200-day average) in a volatile falling market
volatile_down_momentum = 0.00   # weight of 12-1 momentum in a volatile falling market
volatile_down_reversion = 0.15   # weight of RSI-2 mean reversion in a volatile falling market
volatile_down_low_vol = 0.25   # weight of low volatility in a volatile falling market
volatile_down_quality_value = 0.15   # weight of value and quality factors in a volatile falling market
volatile_down_earnings_drift = 0.05   # weight of post-earnings drift in a volatile falling market
volatile_down_hold = 0.05   # weight of buy-and-hold's constant lean in a volatile falling market
volatile_down_ai_verdict = 0.15   # weight of the research verdict in a volatile falling market
smoothing_span = 5     # trading days the final weights are smoothed over (1 to 60)
sector_share = 0.3     # at most this share of max_positions (rounded up) held or bought per sector
warning_factor = 0.5   # each firing playbook warning multiplies its method's weight by this
good_factor = 1.25     # each firing playbook good sign multiplies its method's weight by this (1 to 5)
playbook_cap = 1.5     # the playbook's combined multiplier is clipped to 0 up to this (1 to 5)
tilt_cap = 0.5         # the AI tilt keeps each weight's multiplier within 1 minus to 1 plus this

# The regime-v2 paper account: the regime blend with two changes. A method without a score
# hands its weight to the price methods (trend, momentum, reversion, low volatility), not to
# the steady hold score; and a long-held holding clearly weaker than the best buy not held is
# sold to make room for it. Same listings and rules as the regime account.
[regime_v2_account]
enabled = true             # false: the regime-v2 account decides nothing each tick

# The core-sat paper account: an equal-weight buy and hold of the main list (companies only,
# never a fund or Tesla), bought once and never rebalanced, beside a satellite traded by the regime
# blend whose share is 0 until a signal passes the confirm test and six months of paper trading.
# Fixed a priori, not settings.
[core_sat_account]
enabled = true             # false: the core-sat account decides nothing each tick

# The laya paper account: Laya's daily news score alone traded on the main list's companies under
# the strategy's rules, as evidence whatever its predictive test said. Its weight in core-sat comes
# only from that test's kept verdict, never from a setting.
[laya_account]
enabled = true             # false: the laya account decides nothing each tick

# The data-error checks (Ledgers tab, Data health; `oracle data check`): split-sized jumps, stale
# or repeated bars, bad prices, fund or junk tickers, missing dividends, rename gaps, duplicate
# share classes and testbed member-days missing. They flag only; market data is never edited.
[data_checks]
nightly = true             # run them after each scheduled tick
explain = false            # true: a local Ollama model writes a one-paragraph explanation per flag (the first 25 a run)
explain_model = ""         # the model profile that explains ("" the research slot's); only an Ollama profile is used

# Your investing platform, for the Plan fee and contribution tests (`oracle plan fees`). Rates only:
# amounts are entered per run. No named-platform presets: copy your platform's own price list.
# Changing a value already set waits 7 days (Plan tab, Guardrails; `oracle plan pending`).
[plan]
platform = "percentage"    # which fee you pay: "percentage" or "flat"
percent_fee = 0.0          # the percentage platform's fee, % a year (0.25 is 0.25%)
percent_cap = 0.0          # GBP a year the percentage fee stops at; 0 is no cap
flat_fee = 0.0             # the flat platform's fee, GBP a month
dealing_fee = 0.0          # GBP per buy or sell (0 for free regular investing)
fx_fee = 0.0               # % of each buy taken for currency conversion (0 for a GBP fund)
fund = ""                  # the fund you hold: all_world, developed, sp500 or uk_mix; "" is the numbers' pick
monthly = 0.0              # GBP paid in each month; 0 is not set yet
rule = ""                  # your no-sell rule in your own words; "" is not written yet

# Your numbers for the ISA, workplace pension and Lifetime ISA comparison (Plan tab, Where the next
# pound goes; `oracle plan wrappers`). Nothing about you is assumed: 0 or -1 is not entered yet.
[wrappers]
lisa = false               # show the Lifetime ISA beside the others (off unless you turn it on)
salary = 0.0               # GBP a year before tax
employee_pct = 0.0         # your workplace pension contribution, % (relief included)
employer_pct = 0.0         # your employer's contribution, %
on_salary = false          # true: % of the whole salary; false: of qualifying earnings (the auto-enrolment band)
sacrifice = false          # your contribution is paid by salary sacrifice
born = 0                   # year of birth, for the pension and Lifetime ISA ages
needed_before = -1.0       # GBP a month of your monthly amount you may need before the pension age; -1 is not answered
retire_tax = 20.0          # % income tax on the taxed part of the pension when drawn (20 is the basic rate)
pension_fee = 0.3          # the pension's yearly charge, % of the pot (Nest's published 0.3%)
pension_charge = 1.8       # % taken from each contribution (Nest's published 1.8%)

# regime-v2's rotation, set before any backtest (never fitted to one). Weights are [regime]'s.
[regime_v2]
rotation_min_hold_days = 20   # trading days a holding is kept before it can be rotated out (1 to 250)
rotation_margin = 0.25        # sold when its blended score is this far under the best buy not held
rotation_max = 2              # holdings rotated out a step at most (1 to 10)

# Laya: a small local model that reads each stored headline for a company and says whether it
# is about it, which way it points and what kind of event it is (Company tab, "Score with Laya").
# Its probabilities are uncalibrated. Needs `pip install -e .[laya]`.
[laya]
enabled = true             # false: nothing is scored with Laya
device = "auto"            # auto (the GPU when it has room beside Ollama, else the CPU), gpu or cpu
industry_daily = true      # each tick searches new headlines of held, watched and main-list companies and their industry maps, and scores them per related pair
industry_requests = 400    # news searches one tick's industry research may make (0 to 5000; 0 scores stored news only)
industry_minutes = 30      # minutes one tick's industry research may take, searches and scoring together (1 to 240)
reader_model = "qwen2.5:32b"   # the stronger reader's Ollama model, reading the history once per headline for the predictive test (about 1 headline a second, 70% on the CPU)

# Discovery: finds companies related to the ones you watch (same industry, or named beside
# them in the news), named in the news on your themes, or in news of market movers (big
# risers and fallers, unusual volume, results surprises) in the countries you watch. The
# three sources take turns, one a run; one that finds nothing hands the run to the next.
# Each company found is checked to be a real listing with recent prices, and added to the
# "discovered" watchlist with why it was found. The Watchlist tab's Discovery section runs
# it (Discover now) and lets you remove a company for good or move it to your own list.
# With automation on, each tick also runs it before research (up to 10 minutes, or a third
# of the research budget if that is less), and researches discovered companies after yours.
[discovery]
enabled = true     # false: discovery never runs by itself
per_tick = 1       # companies one run may add (1 to 20)
max_total = 10     # the discovered list never holds more (1 to 500)
per_question = 2   # companies one auto question (Discover tab) may have on the discovered list at once (1 to 20)
never = ["Tesla"]  # company names never added, on any of their listings (Tesla always counts)
ai_trades = true   # the AI account trades discovered companies' verdicts (the strategy account never does)
themes = []        # short topics to look for companies in the news, like ["AI chips", "defence"]; none skips themes
search_related = true   # look beside your companies: same industry, or named with them in the news
search_themes = true    # look in the news on your themes (needs some themes)
search_movers = true    # look in news of big risers and fallers, unusual volume and results surprises where you watch

# The model research runs on (`oracle research`). Ollama, local: `ollama pull <model>` first.
[llm]
backend = "ollama"   # ollama (local) or claude (paid)
model = "qwen3:4b-instruct-2507-q8_0"   # fits an 8GB GPU
base_url = "http://localhost:11434"   # where Ollama listens
max_steps = 16       # tool calls a run may make before it must answer (1 to 50)
timeout_s = 180      # per reply; a cold model load is slow
context = 16384      # tokens of context asked of the model; 16384 fits the 4B model on 8GB
# backend = "claude" runs research on Claude instead (paid, per token): the key comes from
# ANTHROPIC_API_KEY or `ant auth login`, never this file.
claude_model = "claude-opus-5"   # the model when backend is "claude"

# Model profiles: named models a task can run on, edited in Settings > Models too. [llm]
# above is the "default" profile unless a [models.default] table replaces it (max_steps
# stays in [llm] either way). Keys: provider (ollama or claude_api), model, and optionally
# base_url, context (tokens; defaults 16384 on ollama, 200000 on claude_api), timeout_s
# (default 180), and one of key_env (the environment variable holding the key) or key
# (the key itself; never shown). claude_api with neither uses ANTHROPIC_API_KEY or
# `ant auth login`. `oracle models list` shows them; `oracle models test NAME` checks one.
#
# provider = "claude_code" runs your own logged-in `claude -p` CLI (your Claude
# subscription), one process per reply, with no tools. It is off unless the line below is
# set by hand here (an off profile still loads, listed as off), and only a task or run that
# names the profile uses it. model is what
# the CLI takes (sonnet, opus or a full id); no key or base_url. If `claude` is not on the
# PATH the app runs with, set ORACLE_CLAUDE_BIN to its path.
# [models]
# allow_claude_code = true
#
# [models.sub]
# provider = "claude_code"
# model = "sonnet"
#
# [models.big]
# provider = "ollama"
# model = "qwen3:8b"
# context = 8192
#
# [models.claude]
# provider = "claude_api"
# model = "claude-opus-5"
# key_env = "ANTHROPIC_API_KEY"

# Which profile each model task runs on; an unset slot runs on "default". "slots" is never
# a profile's name. The Research and Ask buttons (and `--model`) can pick one profile for
# every stage of a single run instead.
[models.slots]
# research = "default"   # profile of the research loop (tool calls and findings)
# notes = "default"   # profile that reads articles and takes notes; notes are kept per model
# roles = "default"   # profile of the report's roles (bull, bear, risks and the rest)
# queries = "default"   # profile that plans a run's searches
# verdict = "default"   # profile that gives the verdict
# discovery = "default"   # profile of discovery: Discover questions and discovery runs
# ai_account = "big"   # one profile for every stage of research a tick starts for the AI account; unset, those runs use the slots above

# Research sources. SEC EDGAR requires a name and email in every request's User-Agent;
# it is sent to sec.gov only. Unset, the filings tool is skipped.
[research]
# contact = "Your Name you@example.com"   # name and email for SEC EDGAR requests
read_articles = 12   # articles a run reads in full and notes facts from, after its searches (1 to 30)

# API keys for paid sources. ORACLE_<NAME>_KEY in the environment overrides these,
# so keys can stay out of files. This file is gitignored; keep it that way.
[keys]
# eodhd = "..."   # eodhd.com, global daily prices, FX and fundamentals
